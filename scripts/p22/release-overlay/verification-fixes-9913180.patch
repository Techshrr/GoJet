+name: P22 Immutable Candidate Transition
+on:
+  push:
+    branches: [fix/p22-native-admin-session]
+    paths:
+      - scripts/p22/cross_release_test.py
+      - scripts/p22/test_cross_release.py
+      - scripts/p22/assemble_verified_bundle.py
+      - .github/workflows/p22-verify-existing-candidate.yml
+permissions:
+  contents: read
+  actions: read
+jobs:
+  verify-immutable-candidate:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 25
+    env:
+      GOJET_DELIVERY_SOURCE: ce305a9207fd2fe46396e7cf433137c48ab5aec1
+      GOJET_BUILD_RUN_ID: '42460255512'
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Verify unchanged release source and successful build provenance
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          python3 - <<'PYTHON'
+          import json, os, subprocess, urllib.request
+          source=os.environ['GOJET_DELIVERY_SOURCE']
+          changed=subprocess.check_output(['git','diff','--name-only',source,'HEAD'],text=True).splitlines()
+          allowed={'scripts/p22/cross_release_test.py','scripts/p22/test_cross_release.py',
+                   'scripts/p22/assemble_verified_bundle.py','.github/workflows/p22-verify-existing-candidate.yml'}
+          assert set(changed) <= allowed, 'Release content changed: requires a fresh complete build'
+          base='https://api.github.com/repos/'+os.environ['GITHUB_REPOSITORY']+'/actions/runs/'+os.environ['GOJET_BUILD_RUN_ID']
+          def get(url):
+              request=urllib.request.Request(url,headers={'Authorization':'Bearer '+os.environ['GH_TOKEN'],'Accept':'application/vnd.github+json'})
+              with urllib.request.urlopen(request,timeout=30) as response:
+                  return json.load(response)
+          run=get(base)
+          assert run['head_sha']==source and run['path']=='.github/workflows/p22-native-admin-repair.yml'
+          jobs={row['name']:row for row in get(base+'/jobs?per_page=100')['jobs']}
+          assert all(jobs[n]['conclusion']=='success' for n in ['native-admin','upgrade-candidate'])
+          print('Exact candidate build, native installation/recovery and browser evidence verified.')
+          PYTHON
+          python3 -m unittest discover -s scripts/p22 -p 'test_*.py'
+      - uses: actions/download-artifact@v4
+        with:
+          name: GoJet-AdminRepair-10.0.0-rc.2-ce305a9207fd2fe46396e7cf433137c48ab5aec1
+          run-id: 42460255512
+          github-token: ${{ github.token }}
+          path: /tmp/gojet-new-artifact
+      - uses: actions/download-artifact@v4
+        with:
+          name: p22-native-admin-ce305a9207fd2fe46396e7cf433137c48ab5aec1
+          run-id: 42460255512
+          github-token: ${{ github.token }}
+          path: /tmp/gojet-admin-artifact
+      - uses: actions/download-artifact@v4
+        with:
+          name: gojet-v10-p21-payload-32ea29d766b0ac0790964517ce4e220a1208bf0d
+          run-id: 42161906247
+          github-token: ${{ github.token }}
+          path: /tmp/gojet-old-artifact
+      - name: Prepare disposable native host
+        run: |
+          sudo apt-get update -qq
+          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nginx php8.3-fpm php8.3-mysql redis-server clamav clamav-daemon clamav-freshclam
+          sudo systemd-sysusers "$PWD/deploy/sysusers/gojet.conf"
+          sudo systemd-tmpfiles --create "$PWD/deploy/tmpfiles/gojet.conf"
+          sudo usermod -a -G clamav gojet
+          sudo systemctl stop clamav-freshclam.service clamav-daemon.service clamav-daemon.socket
+          sudo timeout 150 freshclam --stdout
+          sudo sed -i '/^[[:space:]]*EnableVersionCommand[[:space:]]/d' /etc/clamav/clamd.conf
+          printf '%s\n' 'EnableVersionCommand yes' | sudo tee -a /etc/clamav/clamd.conf > /dev/null
+          sudo systemctl start mysql redis-server nginx php8.3-fpm clamav-daemon.socket clamav-daemon.service
+          MYSQL_PWD=root mysql -h127.0.0.1 -uroot -e "SET GLOBAL log_bin_trust_function_creators=1; CREATE DATABASE gojet_p22_transition; CREATE USER 'gojet_transition'@'127.0.0.1' IDENTIFIED BY 'p22-ci-only'; GRANT ALL ON gojet_p22_transition.* TO 'gojet_transition'@'127.0.0.1';"
+          sudo timeout 60 bash -c 'until test -S /run/clamav/clamd.ctl; do sleep 1; done'
+      - name: Upgrade immutable rc1, restore interrupted DDL, commit actual candidate
+        run: |
+          set -euo pipefail
+          mkdir -p artifacts/v10/P22/transition
+          OLD_ARCHIVE="$(find /tmp/gojet-old-artifact -name gojet-10.0.0-rc.1-linux-amd64-payload.tar.gz -type f)"
+          test -f "$OLD_ARCHIVE"
+          sudo env P22_DISPOSABLE_NATIVE_CI=1 P21_MYSQL_ADMIN_PASSWORD=root python3 scripts/p22/cross_release_test.py "$OLD_ARCHIVE" /tmp/gojet-new-artifact | tee artifacts/v10/P22/transition/cross-release.json
+      - name: Assemble exact verified candidate and bound evidence
+        run: |
